@page "/exercises"
@using Blazored.LocalStorage
@using TrainerApp.Application.DTOs
@using TrainerApp.Web.Services
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject ILocalStorageService localStorage

<PageTitle>Вправи | TrainerApp</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container mt-5">
            <h3 class="text-center mb-4">Список вправ</h3>

            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Завантаження...</span>
                    </div>
                </div>
            }
            else if (exercises.Any())
            {
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Назва</th>
                            <th>Підходи</th>
                            <th>Повторення</th>
                            <th>Вага (кг)</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exercise in exercises)
                        {
                            <tr>
                                <td>@exercise.Name</td>
                                <td>@exercise.Sets</td>
                                <td>@exercise.Reps</td>
                                <td>@exercise.Weight</td>
                                <td>
                                    <button class="btn btn-info btn-sm" @onclick="() => ViewExercise(exercise.Id)">
                                        Переглянути
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>Немає доступних вправ.</p>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container mt-5 text-center">
            <div class="alert alert-warning">
                <p>Будь ласка, увійдіть, щоб переглянути вправи.</p>
                <button class="btn btn-primary" @onclick="GoToLogin">
                    Увійти
                </button>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ExerciseRecordDto> exercises = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            exercises = await ApiService.GetExercisesAsync() ?? new List<ExerciseRecordDto>();
        }
        catch (Exception ex)
        {
            // Тут можна додати повідомлення про помилку
            exercises = new List<ExerciseRecordDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewExercise(Guid id)  // ← Guid, бо у вас Id типу Guid
    {
        Navigation.NavigateTo($"/exercises/{id}");
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}