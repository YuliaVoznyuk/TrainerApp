@page "/exercises/{Id:guid}"  // ← Guid замість int
@using TrainerApp.Application.DTOs  // ваш namespace з ExerciseRecordDto
@using TrainerApp.Web.Services
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Деталі вправи | TrainerApp</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (exercise != null)
        {
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card shadow">
                            <div class="card-header bg-primary text-white text-center">
                                <h3>@exercise.Name</h3>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-4">Кількість підходів</dt>
                                    <dd class="col-sm-8">@exercise.Sets</dd>

                                    <dt class="col-sm-4">Повторення</dt>
                                    <dd class="col-sm-8">@exercise.Reps</dd>

                                    <dt class="col-sm-4">Вага (кг)</dt>
                                    <dd class="col-sm-8">@exercise.Weight</dd>
                                </dl>

                                <div class="text-center mt-4">
                                    <button class="btn btn-secondary" @onclick="GoBack">
                                        Назад до списку вправ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (isLoading)
        {
            <div class="text-center mt-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Завантаження...</span>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center mt-5">
                <p>Вправу не знайдено.</p>
                <button class="btn btn-primary" @onclick="GoBack">Назад</button>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-info text-center mt-5">
            <p>Будь ласка, увійдіть, щоб переглянути деталі вправи.</p>
            <button class="btn btn-primary" @onclick="Login">
                Увійти
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private void Login()
    {
        Navigation.NavigateTo("/login");
    }
    [Parameter] public int Id { get; set; }  // ← Guid, а не int

    private ExerciseRecordDto? exercise;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            exercise = await ApiService.GetExerciseAsync(Id);  // ваш метод в ApiService
        }
        catch (Exception ex)
        {
            // Логування або повідомлення
            exercise = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/exercises");
    }
}